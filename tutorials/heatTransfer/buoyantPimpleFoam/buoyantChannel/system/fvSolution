FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    rho
    {}
    "p_rgh|p_rghFinal"
    {
        solver          CG;
        preconditioner  DIC;
        tolerance       1e-08;
        relTol          0;
    }
    "U|UFinal"
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0;
    }
    "h|hFinal"
    {
        solver          BiCGStab;
        preconditioner  DILU;
        minIter         1;
        tolerance       1e-08;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors 1;
    nCorrectors 2;
    nNonOrthogonalCorrectors 0;

    pRefCell 0;
    pRefValue 1e5;

    closedVolume no;
}

