FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
(
    "liblduSolvers.so"
);

application simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2000;

deltaT          1;

writeControl    timeStep;

writeInterval   200;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression yes;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

functions
(
    outlet
    {
        type patchFlux;
        functionObjectLibs ("libfluxFunctionObjects.so");
        allPatches no;
        patch outlet;
        phi phi;
        file "outlet.dat";
    }
    lowerWall
    {
        type patchFlux;
        functionObjectLibs ("libfluxFunctionObjects.so");
        allPatches no;
        patch lowerWall;
        phi phi;
        file "lowerWall.dat";
    }
);

