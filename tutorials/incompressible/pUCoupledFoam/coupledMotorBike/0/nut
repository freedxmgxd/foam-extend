FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-5;

boundaryField
{
    inlet
    {
        type            zeroGradient;
        value           uniform 1e-5;
    }
    outlet
    {
        type            zeroGradient;
        value           uniform 1e-5;
    }
    lowerWall
    {
        type            nutkWallFunction;
        value           uniform 1e-5;
    }
    upperWall
    {
        type            zeroGradient;
        value           uniform 1e-5;
    }
    "motorBike_.*"
    {
        type            nutkWallFunction;
        value           uniform 1e-5;
    }
    frontAndBack
    {
        type            zeroGradient;
        value           uniform 1e-5;
    }
}

