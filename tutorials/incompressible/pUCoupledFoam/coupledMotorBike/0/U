FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "initialConditions"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $flowVelocity;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    lowerWall
    {
        type            fixedValue;
        value           uniform $flowVelocity;
    }
    "motorBike_.*"
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    upperWall
    {
        type            blockSymmPlane;
        value           uniform (0 0 0);
    }
    frontAndBack
    {
        type            blockSymmPlane;
        value           uniform (0 0 0);
    }
}

