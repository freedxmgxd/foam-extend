FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    Up
    {
        solver          AMG;
        cycle           V-cycle;

        coarseningType  SAMG;

        norm            componentNorm;
        normComponent   3;

        smoother ILUC0;
        nPreSweeps      1;
        nPostSweeps     3;

        minCoarseEqns   20;
        nMaxLevels      100;
        scale           on;

        groupSize       4;
        minGroupSize    2;
        maxGroupSize    7;

        minIter         1;
        maxIter         100;
        tolerance       1e-6;
        relTol          0;
    }
    p
    {
        solver amgSolver;
        cycle V-cycle;
        policy cluster;
        nPreSweeps 1;
        nPostSweeps 3;
        groupSize 4;
        minCoarseEqns 20;
        nMaxLevels 100;
        scale on;
        smoother ILUC0;
        minIter 1;
        maxIter 100;
        tolerance 1e-7;
        relTol 0.0;
    }
    kOmega
    {
        solver           BiCGStab;
        preconditioner   ILUC0;
        minIter          1;
        maxIter          100;
        tolerance        1e-7;
        relTol           0.0;
    }
    k
    {
        solver           BiCGStab;
        preconditioner   ILU0;
        tolerance        1e-7;
        relTol           0.0;
    }
    omega
    {
        solver           BiCGStab;
        preconditioner   ILU0;
        tolerance        1e-7;
        relTol           0.0;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 2;
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
}

blockSolver
{
    convergence 1e-6;

    pRefCell 0;
    pRefValue 0;
}

fieldBounds
{
    U      100;
    p      -1e06 1e06;
}

relaxationFactors
{
    U               0.85;
    k               0.9;
    omega           0.9;
}

cache
{
    grad(U);
    grad(p);
    grad(k);
    grad(omega);
}

