FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
(
    "liblduSolvers.so"
)

application     conjugateHeatSimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1000;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

functions
(
    heatFluxFluid
    {
        // Type of functionObject
        type patchHeatFlux;
        patch right;
        outputControl timeStep;
        outputInterval 1;
        T              T;
        gamma          kappaEff;
        file "heatFluxFluid.dat";
    }
    heatFluxSolid
    {
        // Type of functionObject
        type patchHeatFlux;
        patch left;
        outputControl timeStep;
        outputInterval 1;
        region solid;
        T              T;
        gamma          k;
        file "heatFluxSolid.dat";
    }
);

