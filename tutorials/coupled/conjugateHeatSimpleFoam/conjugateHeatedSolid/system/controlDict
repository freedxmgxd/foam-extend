FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
(
    "liblduSolvers.so"
)

application     conjugateHeatSimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         500;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

functions
(
    heatFluxLeft
    {
        // Type of functionObject
        type patchHeatFlux;
        functionObjectLibs ("librwdi.so");
        patch left;
        outputControl timeStep;
        outputInterval 1;

        T T;
        phi rhoCpPhi;
        gamma kappaEff;
        file "fluid-left_heat.dat";
    }
    heatFluxRight
    {
        // Type of functionObject
        type patchHeatFlux;
        functionObjectLibs ("librwdi.so");
        patch right;
        outputControl timeStep;
        outputInterval 1;

        T T;
        phi rhoCpPhi;
        gamma kappaEff;
        file "fluid-right_heat.dat";
    }
    heatFluxBottomWall
    {
        // Type of functionObject
        type patchHeatFlux;
        functionObjectLibs ("librwdi.so");
        patch bottomWall;
        outputControl timeStep;
        outputInterval 1;

        T T;
        phi rhoCpPhi;
        gamma kappaEff;
        file "fluid-bottomWall_heat.dat";
    }
    heatFluxCHTFluid
    {
        // Type of functionObject
        type patchHeatFlux;
        functionObjectLibs ("librwdi.so");
        patch topWall;
        outputControl timeStep;
        outputInterval 1;

        T T;
        phi rhoCpPhi;
        gamma kappaEff;
        file "fluid-topWall_heat.dat";
    }
    heatFluxCHTSolid
    {
        // Type of functionObject
        type patchHeatFlux;
        functionObjectLibs ("librwdi.so");
        region solid;
        patch bottom;
        outputControl timeStep;
        outputInterval 1;

        T T;
        phi none;
        gamma k;
        file "solid-bottom_heat.dat";
    }
    minMaxT
    {
        type minMaxField;
        functionObjectLibs ("libfieldFunctionObjects.so");
        name T;
    }
    minMaxTSolid
    {
        type minMaxField;
        region solid;
        functionObjectLibs ("libfieldFunctionObjects.so");
        name T;
    }
);

