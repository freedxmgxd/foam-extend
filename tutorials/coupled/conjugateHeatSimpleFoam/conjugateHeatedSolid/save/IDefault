FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      IDefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    topWall
    {
        type greyDiffusiveRadiation;
        T T;
        emissivity 0.5;
        value uniform 0;
    }
    left
    {
        type zeroGradient;
    }
    right
    {
        type zeroGradient;
    }
    bottomWall
    {
        type greyDiffusiveRadiation;
        T T;
        emissivity 0.5;
        value uniform 0;
    }
    frontAndBack
    {
        type empty;
    }
}

