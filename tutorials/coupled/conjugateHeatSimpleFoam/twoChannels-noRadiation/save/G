FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      G;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    downLeft
    {
        type            zeroGradient;
    }
    downRight
    {
        type            zeroGradient;
    }
    upLeft
    {
        type            zeroGradient;
    }
    upRight
    {
        type            zeroGradient;
    }
    bottomWall
    {
        type            MarshakRadiation;
        T               T;
        emissivity      0.5;
        value           uniform 0;
    }
    topWall
    {
        type            MarshakRadiation;
        T               T;
        emissivity      0.5;
        value           uniform 0;
    }
    bottomCHT
    {
        type            MarshakRadiation;
        T               T;
        emissivity      0.5;
        value           uniform 0;
    }
    topCHT
    {
        type            MarshakRadiation;
        T               T;
        emissivity      0.5;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

