FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 323;

boundaryField
{
    downLeft
    {
        type            fixedValue;
        value           uniform 1500;
    }
    downRight
    {
        type            inletOutlet;
        inletValue      uniform 323;
        value           uniform 323;
    }
    upLeft
    {
        type            inletOutlet;
        inletValue      uniform 323;
        value           uniform 323;
    }
    upRight
    {
        type            fixedValue;
        value           uniform 323;
    }
    bottomWall
    {
        type            fixedValue;
        value           uniform 1500;
    }
    topWall
    {
        type            fixedValue;
        value           uniform 323;
    }
    bottomCHT
    {
        type            chtRcTemperature;
        radiation       off;
        K               KEff;
        remoteField     T;
        value           uniform 323;
    }
    topCHT
    {
        type            chtRcTemperature;
        radiation       off;
        K               KEff;
        remoteField     T;
        value           uniform 323;
    }
    frontAndBack
    {
        type            empty;
    }
}

