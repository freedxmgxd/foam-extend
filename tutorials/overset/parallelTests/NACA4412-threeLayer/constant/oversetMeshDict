FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      oversetMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

interpolation
{
    interpolationSchemes (injection);
    default injection;
    
    // interpolationSchemes (inverseDistance);
    // default inverseDistance;
}

// Names or patches that determine hole cells
holePatches  ( airfoil );

regions
(
    backgroundMesh
    {
        // Donor regions
        donorRegions ( middleMesh );

        fringe
        {
            type overlap;

            // Manual holes
            holes backHoles;

            // Optional list of patches to start the fringe minimisation from
            initPatchNames ();

            // Suitability
            suitablePairFraction 0.4;

            // Whether to start fringe assembly from the previous set of
            // acceptors (for moving mesh cases)
            cacheFringe no;

            donorSuitability
            {
                type noSuitability;
                // type cellVolumeDiff;
                threshold 0.4;
            }
        }
    }

    middleMesh
    {
        // Donor regions
        donorRegions ( frontMesh backgroundMesh );

        fringe
        {
            type composite;

            baseFringes
            (
                outer
                {
                    type faceCells;
                    patches ( OversetMiddle );
                }
                inner
                {
                    type overlap;

                    // Manual holes
                    holes middleHoles;

                    // Suitability
                    suitablePairFraction 0.5;

                    // Whether to start fringe assembly from the previous set of
                    // acceptors (for moving mesh cases)
                    cacheFringe no;

                    donorSuitability
                    {
                        // type cellVolumeDiff;
                        type noSuitability;
                        threshold 0.5;
                    }
                }
            );
        }
    }

    frontMesh
    {
        // Donor regions
        donorRegions ( middleMesh );

        fringe
        {
            type faceCells;

            patches (OversetFront);
        }
    }
);

