         preconditioner    ILUC0;

         minIter           1;
         maxIter           1000;
         tolerance         1e-7;
         relTol            0.0;
    }
    U
    {
        solver           BiCGStab;
        preconditioner   DILU;
        tolerance        1e-08;
        relTol           0.0;
        minIter          1;
    }
    k
    {
        solver           BiCGStab;
        preconditioner   DILU;
        tolerance        1e-08;
        relTol           0;
        minIter          1;
    }
    omega
    {
        solver           BiCGStab;
        preconditioner   DILU;
        tolerance        1e-08;
        relTol           0;
        minIter          1;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 1;
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
}

relaxationFactors
{
    equations
    {
        U 0.5;
        k 0.5;
        omega 0.5;
    }
    fields
    {
        p 0.3;
    }
}

