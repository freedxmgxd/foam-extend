solvers
{
    "p|pFinal"
    {
        solver           BiCGStab;
        preconditioner   ILUC0;

        maxIter          1000;
        tolerance        1e-7;
        relTol           0;
    }
    U
    {
        solver           BiCGStab;
        preconditioner   ILUC0;

        maxIter          1000;
        tolerance        1e-7;
        relTol           0;
    }
}

potentialFlow
{
}

PISO
{
    nCorrectors 4;
}

