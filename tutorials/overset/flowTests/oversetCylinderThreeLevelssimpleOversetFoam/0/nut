FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions [0 2 -1 0 0 0 0];

internalField uniform 1e-5;

boundaryField
{
    oversetFaces
    {
        type    overset;
        value   uniform 1e-5;

        coupledFringe yes;

        setHoleCellValue  yes;
        holeCellValue     1e-5;
    }
    in
    {
        type    zeroGradient;
    }
    out
    {
        type    zeroGradient;
    }
    top
    {
        type    zeroGradient;
    }
    bottom
    {
        type    zeroGradient;
    }
    cylinder
    {
        type    nutkWallFunction;
        Cmu     0.09;
        kappa   0.41;
        E       9.8;
        value   uniform 1e-5;
    }
    outerCylinder
    {
        type    zeroGradient;
    }
    refine
    {
        type    zeroGradient;
    }
    frontAndBack
    {
        type    empty;
    }
}

