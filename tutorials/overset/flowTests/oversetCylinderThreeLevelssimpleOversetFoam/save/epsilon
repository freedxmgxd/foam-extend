FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions [0 2 -3 0 0 0 0];

internalField uniform 220.454;

boundaryField
{
    oversetFaces
    {
        type    overset;
        value   uniform 220.454;

        coupledFringe yes;

        setHoleCellValue  yes;
        holeCellValue     220.454;
    }
    in
    {
        type nuRatioEpsilon;
        nuRatio 1;
        value   uniform 220.454;
    }
    out
    {
        type        inletOutlet;
        inletValue  uniform 220.454;
        value       uniform 220.454;
    }
    top
    {
        type    fixedValue;
        value   uniform 220.454;
    }
    bottom
    {
        type        inletOutlet;
        inletValue  uniform 220.454;
        value       uniform 220.454;
    }
    cylinder
    {
        type        epsilonWallFunction;
        refValue    uniform 0;
        value       uniform 220.454;

        Cmu         0.09;
        kappa       0.41;
        E           9.8;
        beta1       0.075;
    }
    outerCylinder
    {
        type    zeroGradient;
    }
    refine
    {
        type    zeroGradient;
    }
    frontAndBack
    {
        type    empty;
    }
}

