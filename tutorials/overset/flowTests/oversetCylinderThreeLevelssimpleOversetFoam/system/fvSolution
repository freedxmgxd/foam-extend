FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver           BiCGStab;
        preconditioner   ILUC0;

//         solver           CG;
//         preconditioner   DIC;

        minIter          1;
        maxIter          1000;
        tolerance        1e-7;
        relTol           0;
    }
    U
    {
        solver           BiCGStab;
        preconditioner   ILUC0;

        minIter          1;
        maxIter          1000;
        tolerance        1e-7;
        relTol           0;
    }
    k
    {
        solver           BiCGStab;
        preconditioner   ILUC0;

        minIter          1;
        maxIter          1000;
        tolerance        1e-7;
        relTol           0;
    }
    epsilon
    {
        solver           BiCGStab;
        preconditioner   ILUC0;

        minIter          1;
        maxIter          1000;
        tolerance        1e-7;
        relTol           0;
    }
}

potentialFlow
{
}
SIMPLE
{
}

relaxationFactors
{
    fields
    {
        p 0.3;
    }
    equations
    {
        U 0.5;
        k 0.5;
        epsilon 0.5;
    }
}

