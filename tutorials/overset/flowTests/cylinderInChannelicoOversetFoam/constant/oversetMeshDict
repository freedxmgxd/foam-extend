FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      oversetMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

interpolation
{
    interpolationSchemes (injection);

    default injection;
}

// Names or patches that determine hole cells
holePatches  ( cylinder );

regions
(
    background
    {
        // Donor regions
        donorRegions ( front );

        // Manual fringe, using cell sets
        // fringe
        // {
        //     type manual;
        //     holes "backHole";
        //     acceptors "backFringe";
        // }

        fringe
        {
            type overlap;

            suitablePairFraction 0.85;
            cacheFringe no;

            donorSuitability
            {
                type noSuitability;
                // type cellVolumeDiff;

                // Tune threshold to achieve good overlap
                threshold 0.1;
            }
        }
    }

    front
    {
        donorRegions ( background );

        fringe
        {
            type faceCells;
            patches ( outerCylinder );
        }
    }
);

